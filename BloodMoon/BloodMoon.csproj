<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <DuckovPath>d:\xiazai\jli\Escape from Duckov</DuckovPath>
    <SubPath>\Duckov_Data\Managed\</SubPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- 通配引用必须以 .dll 结尾：Managed 目录里还有反编译工具留下的 *.membercheck.csv，
         否则会被当成程序集解析，产生 9 条 warning MSB3246 (Image is too small)。 -->
    <Reference Include="$(DuckovPath)$(SubPath)TeamSoda.*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovPath)$(SubPath)ItemStatsSystem.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovPath)$(SubPath)AstarPathfindingProject.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovPath)$(SubPath)PackageTools.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovPath)$(SubPath)Drawing.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovPath)$(SubPath)Unity*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovPath)$(SubPath)UniTask*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(DuckovPath)$(SubPath)DOTween*.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- info.ini 只存在于游戏模组目录（Duckov_Data\Mods\BloodMoon\info.ini），源码目录没有。
         加 Exists 条件避免原地构建时报 error MSB3030: 无法复制文件"…\BloodMoon\info.ini"。 -->
    <None Include="info.ini" CopyToOutputDirectory="PreserveNewest" Condition="Exists('info.ini')" />
  </ItemGroup>
</Project>
